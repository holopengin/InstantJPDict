    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="9"
        android:pathData="M80 56m-18 0a18 18 0 1 0 36 0a18 18 0 1 0 -36 0" />
    <path
        android:strokeColor="#FF000000"
