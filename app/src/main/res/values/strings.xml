<resources>
    <string name="app_name">InstantJPDict</string>

    <!-- #82/#87: the static shortcut's labels (res/xml/shortcuts.xml). The platform
         requires the short label to be a resource string, and the long label is
         what a launcher shows when it has the room. The short label is the name
         the launcher lists it under, "InstantJPCam" (#87); the long label states
         the action. -->
    <string name="shortcut_camera_short_label">InstantJPCam</string>
    <string name="shortcut_camera_long_label">Open camera</string>

    <!-- #89: the manual-lookup screen. `manual_lookup_label` is what BOTH the
         launcher's long-press menu and the text-selection toolbar show (the
         activity's own android:label), so it is a clear verb phrase rather than
         the product name: in the selection menu it is the entry the user picks
         beside Cut/Copy/Paste. The two shortcut labels mirror the camera pair. -->
    <string name="manual_lookup_label">Look up in InstantJPDict</string>
    <string name="manual_lookup_title">Manual lookup</string>
    <string name="manual_lookup_hint">Japanese or romaji, e.g. 猫 or neko</string>
    <string name="manual_lookup_hint_en">Type English to find Japanese</string>
    <string name="manual_lookup_mode_jp_to_en">JP → EN</string>
    <string name="manual_lookup_mode_en_to_jp">EN → JP</string>
    <string name="shortcut_lookup_short_label">Look up</string>
    <string name="shortcut_lookup_long_label">Look up text</string>
</resources>
