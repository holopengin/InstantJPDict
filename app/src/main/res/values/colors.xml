<?xml version="1.0" encoding="utf-8"?>
<!--
  ui-deepseek design 1 — "Harbour".

  A hand-picked Material 3 palette rather than a bare theme default, so the
  screen reads as a deliberate product on devices that do not offer Material You
  (API 30/31, or a vendor ROM with no dynamic colour). On API 31+ `App` calls
  DynamicColors, and every role below is replaced by the wallpaper's tonal
  palette — this is the fallback, not the only face.

  Roles are named by their Material 3 slot, not their hue, so the night file can
  re-point them without the light values leaking through.
-->
<resources>
    <!-- Primary: a deep harbour azure. The camera and accessibility actions. -->
    <color name="md_primary">#1A5C86</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#CBE6FF</color>
    <color name="md_on_primary_container">#001D32</color>

    <!-- Secondary: a warm slate, for tonal buttons and secondary surfaces. -->
    <color name="md_secondary">#4E616D</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#D1E5F3</color>
    <color name="md_on_secondary_container">#091E28</color>

    <!-- Tertiary: a muted plum accent for the debug/tuning surfaces. -->
    <color name="md_tertiary">#7C5268</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#FFD8E7</color>
    <color name="md_on_tertiary_container">#30102A</color>

    <color name="md_error">#B3261E</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#F9DEDC</color>
    <color name="md_on_error_container">#410E0B</color>

    <color name="md_background">#F7FAFD</color>
    <color name="md_on_background">#191C1E</color>
    <color name="md_surface">#F7FAFD</color>
    <color name="md_on_surface">#191C1E</color>
    <color name="md_surface_variant">#DDE3EA</color>
    <color name="md_on_surface_variant">#41484D</color>
    <color name="md_surface_container_low">#F1F4F9</color>
    <color name="md_surface_container">#EBEEF4</color>
    <color name="md_surface_container_high">#E5E8EE</color>
    <color name="md_surface_container_highest">#DFE2E8</color>
    <color name="md_outline">#71787E</color>
    <color name="md_outline_variant">#C1C7CE</color>

    <!-- Recommended: a positive green for the catalog's "Recommended" badge.
         Not a Material role (M3 has no success colour), so it lives here rather
         than in themes.xml; the night file re-points it. -->
    <color name="md_recommended">#1B7F3B</color>
    <color name="md_on_recommended">#FFFFFF</color>
</resources>
