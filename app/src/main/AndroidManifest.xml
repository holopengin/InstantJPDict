<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #72: opt out of predictive back. Targeting SDK 35 enables it by default,
         which routes back through the focused window's OnBackInvokedDispatcher.
         An accessibility overlay window never gets that callback (see
         OcrAccessibilityService.registerBackCallback), so back died on our
         window. Opting out restores legacy KEYCODE_BACK dispatch, which this
         service's key filtering does receive. -->
    <!-- #78 — camera mode. The CAMERA permission is declared because the app ships
         a viewfinder (ProtoCameraActivity) that opens the back camera; the activity
         asks for it at runtime before the camera is used. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- #71 — dictionary catalog. The catalog's Import button downloads a
         Yomitan zip from a pinned upstream URL, so the app now declares
         INTERNET. This is the one permission the catalog adds and the only
         change #71 makes to the app's privacy posture: the app is fully offline
         until the user taps Import, and the licence viewer, OCR, pitch install
         and manual .zip import all still work with no network at all. When the
         device is offline the catalog says "Download unavailable" instead of
         failing, and no other feature touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Not required: the app installs and works on a device with no camera;
         the viewfinder is simply unavailable there. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- The feedback/crash email picker resolves the installed mail apps with
         queryIntentActivities, which package visibility (API 30+) otherwise
         filters down to nothing. Declaring the mailto intent makes apps that
         answer it visible to us. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstantJPDict">
        <!-- #82 — the launcher entry, and now also the shortcut's target.
             singleTop: the camera shortcut arrives here as an explicit intent
             with CameraShortcut.ACTION_OPEN_CAMERA (res/xml/shortcuts.xml), and
             when this activity is ALREADY the top of the task — the user is on
             the dictionary screen — reusing the instance (onNewIntent) opens the
             camera instead of stacking a second dictionary screen under it. It
             changes nothing else: an ordinary MAIN launcher tap delivers no such
             action, and a launch while the camera or the OCR view is on top
             still gets a new instance from the platform, because singleTop
             reuses an instance only when it is the one on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:launchMode="singleTop"
            android:theme="@style/Theme.InstantJPDict">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- #82 — the STATIC shortcut list, read by a launcher's long-press
                 menu and by Pixel's Quick Tap ("Open app", then the gear).
                 Static, so it exists from install and works cold with no runtime
                 push; the camera action has no state to reflect and is not
                 updated by anything, so there is no dynamic half to keep in
                 sync. The declaration and the full reasoning (why it targets
                 this already-exported entry rather than the unexported
                 viewfinder, and why that is the smaller export surface) live in
                 res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Debug/tuning screen (#14/#86), reached from the Settings card. Not
             exported: it only reads and writes this app's own preferences. -->
        <activity
            android:name=".DebugSettingsActivity"
            android:exported="false"
            android:label="${appLabel}"
            android:theme="@style/Theme.InstantJPDict" />

        <!-- The crash screen, started by CrashReporter after an uncaught
             exception wrote its report file. Not exported, excluded from
             recents: it is a moment, not somewhere to return to. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.InstantJPDict" />

        <!-- #57 (Feat — image share intent): a single shared image goes through
             the same OCR/lookup surface as the accessibility overlay. Only
             ACTION_SEND is handled; ACTION_SEND_MULTIPLE is a later follow-up. -->
        <!-- #78 — orientation. fullSensor, NOT a pin: like the
             viewfinder, this window follows the device from its FIRST layout, so
             a capture taken holding the phone sideways hands off to an OCR view
             that is already landscape — no post-creation quarter turn. The
             exported ACTION_SEND entry point is not pinned by it either:
             fullSensor asks the platform to resolve the orientation from the
             sensor, it does not freeze a family.

             configChanges, deliberately. A later quarter turn used to RE-CREATE
             this activity, which recomposed the image at the new container size
             (the overlay's box coordinates are composite pixels, 1:1 with the
             surface) — and threw away the detect/recognise pass, re-running it
             on an image that had not changed. The maintainer's report: "it still
             re-runs the inference when rotating the phone while the OCR view is
             open". Handled in place instead: ShareImageActivity.onConfigurationChanged
             KEEPS the run and re-fits the composite and its boxes to the new
             container (ImageShareFit.refit owns the mapping). orientation +
             screenSize are what a quarter turn actually reports; screenLayout,
             smallestScreenSize and keyboardHidden are declared with them so the
             resize/IMEs of the same window cannot re-create it either.

             This replaces the RUNTIME request the camera handoff used to make:
             ShareImageActivity asked for FULL_SENSOR in onCreate from
             InheritedOrientation.EXTRA_CAMERA_HOLD, which resolved after the
             first layout — the activity was laid out in the launch orientation,
             then re-created when the request landed. That is the "starts
             portrait, then it rotates" the maintainer saw. Declared here, the
             orientation is part of the window the activity is created with. -->
        <activity
            android:name=".ShareImageActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="${appLabel}"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.InstantJPDict.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- #78 — our own viewfinder, launched from a main-activity
             button. fullSensor, NOT portrait: the whole window has to turn with
             the phone, so the preview, the reticle and the capture turn
             together. Rotating only the camera stream inside a portrait lock is
             the thing to avoid — the preview would appear turned inside an
             upright portrait window. fullSensor is also the sensor value the
             documented rule "the sensor is used even if the user locked
             sensor-based rotation" covers, so a locked auto-rotate still turns
             the viewfinder. configChanges keeps the activity AND the bound
             camera alive across the quarter turn: that was the one real thing
             the old portrait lock bought, and it is bought back here. -->
        <activity
            android:name=".ProtoCameraActivity"
            android:exported="false"
            android:label="${appLabel}"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.InstantJPDict" />

        <!-- #78 — serves the captured JPEG to ShareImageActivity as a content
             URI, so the capture enters through the same EXTRA_STREAM entry the
             system share sheet uses and there is one decode/compose/render path
             instead of two. It is not exported, and it grants read access to the
             camera's own cache subdirectory only (res/xml/proto_file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.protofileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/proto_file_paths" />
        </provider>

        <service
            android:name=".OcrAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>