<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- #72: opt out of predictive back. Targeting SDK 35 enables it by default,
         which routes back through the focused window's OnBackInvokedDispatcher.
         An accessibility overlay window never gets that callback (see
         OcrAccessibilityService.registerBackCallback), so back died on our
         window. Opting out restores legacy KEYCODE_BACK dispatch, which this
         service's key filtering does receive. -->
    <!-- #78 PROTOTYPE — camera mode. Everything below that is marked PROTO
         exists only for the throwaway prototype branch
         proto/78-camera-viewfinder and must not reach main as-is. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Not required: the app installs and works on a device with no camera;
         the prototype activity is simply unusable there. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstantJPDict">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.InstantJPDict">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- #57 (Feat — image share intent): a single shared image goes through
             the same OCR/lookup surface as the accessibility overlay. Only
             ACTION_SEND is handled; ACTION_SEND_MULTIPLE is a later follow-up. -->
        <!-- #78 PROTOTYPE — orientation. fullSensor, NOT a pin: like the
             viewfinder, this window follows the device from its FIRST layout, so
             a capture taken holding the phone sideways hands off to an OCR view
             that is already landscape — no post-creation quarter turn, and
             therefore no re-creation of the composite in the moment the OCR run
             has just started. The exported ACTION_SEND entry point is not pinned
             by it either: fullSensor asks the platform to resolve the orientation
             from the sensor, it does not freeze a family. Deliberately NO
             configChanges: the quarter-turn re-creation is what recomposes the
             image at the new container size, and stopping it would leave
             portrait-space boxes over a resized surface.

             This replaces the RUNTIME request the camera handoff used to make:
             ShareImageActivity asked for FULL_SENSOR in onCreate from
             InheritedOrientation.EXTRA_CAMERA_HOLD, which resolved after the
             first layout — the activity was laid out in the launch orientation,
             then re-created when the request landed. That is the "starts
             portrait, then it rotates" the maintainer saw. Declared here, the
             orientation is part of the window the activity is created with. -->
        <activity
            android:name=".ShareImageActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.InstantJPDict.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- #78 PROTOTYPE — our own viewfinder, launched from a main-activity
             button. fullSensor, NOT portrait: the whole window has to turn with
             the phone, so the preview, the reticle and the capture turn
             together. Rotating only the camera stream inside a portrait lock is
             the thing to avoid — the preview would appear turned inside an
             upright portrait window. fullSensor is also the sensor value the
             documented rule "the sensor is used even if the user locked
             sensor-based rotation" covers, so a locked auto-rotate still turns
             the viewfinder. configChanges keeps the activity AND the bound
             camera alive across the quarter turn: that was the one real thing
             the old portrait lock bought, and it is bought back here. -->
        <activity
            android:name=".ProtoCameraActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.InstantJPDict" />

        <!-- #78 PROTOTYPE — serves the captured JPEG to ShareImageActivity as a
             content URI, so the capture uses the same EXTRA_STREAM entry the
             system share sheet uses. Throwaway: a real camera feature would
             probably hand the bitmap over in-process instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.protofileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/proto_file_paths" />
        </provider>

        <service
            android:name=".OcrAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>